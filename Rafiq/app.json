{
  "expo": {
    "name": "Rafiq",
    "slug": "Rafiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ios-icon-light.png",
    "owner": "rafiq-elmuslim",
    "scheme": "rafiq",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fbf8f1",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/rafiq.icon",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.rafiqelmuslim.Rafiq",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8DCC3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.rafiqelmuslim.Rafiq",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0E7D2",
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0A2B26",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يحتاج رفيق إلى موقعك لحساب مواقيت الصلاة في مدينتك بدقة وتحديد اتجاه القبلة. لا يُشارك موقعك مع أي جهة.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "يستخدم رفيق حساسات الحركة لتوجيه بوصلة القبلة فقط، ولا يحتفظ بأي بيانات.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "يستخدم رفيق حساسات الحركة لتوجيه بوصلة القبلة فقط، ولا يحتفظ بأي بيانات."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "يعرض رفيق اتجاه القبلة فوق صورة الكاميرا مباشرة. لا تُلتقط أي صور ولا تُحفظ.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "03183269-da10-45fd-a92a-44a97860f6d2"
      }
    }
  }
}
